[Unit]
Description=Family Robot Voice Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=family-robot
Group=family-robot
EnvironmentFile=/etc/family-robot/server.env
ExecStart=/opt/family-robot/current/gateway
WorkingDirectory=/var/lib/family-robot
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
