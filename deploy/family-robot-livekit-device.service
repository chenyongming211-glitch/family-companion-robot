# DEPRECATED_PRODUCT_PATH (2026-10-25): legacy cascade deployment template.
# Not the default Go Realtime service; retained until separate consumer-aware retirement.
# This annotation does not change or stop an installed service. See docs/CODE_LIFECYCLE.md.
[Unit]
Description=Family robot isolated Opus device bridge to LiveKit
After=network-online.target family-robot-livekit-dev.service
Wants=network-online.target
Requires=family-robot-livekit-dev.service

[Service]
Type=simple
User=family-robot-livekit
Group=family-robot-livekit
WorkingDirectory=/opt/family-robot-livekit-dev
EnvironmentFile=/etc/family-robot/livekit-dev.env
Environment=VOICE_DEVICE_LISTEN=127.0.0.1:18020
Environment=VOICE_DEVICE_BACKEND=ws://127.0.0.1:18010/v1/audio?mode=drain
Environment=VOICE_TEST_KEEP_OPEN=1
ExecStart=/opt/family-robot-livekit-runtime/bin/livekit-device-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
