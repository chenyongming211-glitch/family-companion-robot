# Copy values into a root-managed file. Never commit real credentials.
DASHSCOPE_API_KEY=
QWEN_REALTIME_URL=wss://your-workspace.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime?model=qwen3.8-omni-flash-realtime
QWEN_VOICE=Tina
QWEN_VAD=semantic_vad
ROBOT_LISTEN_ADDR=127.0.0.1:8000
ROBOT_PUBLIC_WS_URL=ws://127.0.0.1:8000/xiaozhi/v1/
# Generate each secret independently: openssl rand -hex 32
ROBOT_DEVICE_TOKEN=
ROBOT_OTA_SECRET=
# Optional exact MAC allowlist for the first device.
ROBOT_ALLOWED_DEVICE=
# Optional protected schema_version=1 JSON allowlist; 0600/0400, at most 64 devices.
# Each entry has mac and an independently generated token. Keep the primary above
# present with its unchanged token. Each service loads this file once at startup.
ROBOT_DEVICE_REGISTRY=
ROBOT_MAX_SESSIONS=1
ROBOT_IDLE_TIMEOUT=2m
ROBOT_SESSION_TIMEOUT=30m

# Gateway text snapshots only; leave empty to disable persistence explicitly.
# The systemd unit permits writes only to this exact directory.
ROBOT_RECORD_DIR=/var/lib/family-robot/records
ROBOT_RECORD_RETENTION=168h
