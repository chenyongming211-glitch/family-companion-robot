QWEN_VOICE=Tina
QWEN_VAD=semantic_vad
ROBOT_LISTEN_ADDR=127.0.0.1:8000
ROBOT_PUBLIC_WS_URL=ws://127.0.0.1:8000/xiaozhi/v1/
