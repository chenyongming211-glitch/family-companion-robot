+void Application::RecoverListeningFailure() {
+    // Main-task recovery: prevent a deferred start or popup from surviving the
+    // failed invocation. Close even a partially opened channel before retry.
+    pending_listening_start_ = false;
+    play_popup_on_listening_ = false;
+    audio_service_.SetExperimentUplink(false);
+    audio_service_.EnableVoiceProcessing(false);
+    protocol_->CloseAudioChannel();
+    // Close queues its state callback before this recovery continuation. Keep
+    // detection stopped until both run, so WAKE-before-SCHEDULE dispatch cannot
+    // start a retry that the old close callback would then cancel.
+    Schedule([this]() {
+        SetDeviceState(kDeviceStateIdle);
+        audio_service_.EnableWakeWordDetection(true);
+    });
+}
