+void Application::CancelPendingRealtimeStart() {
+    pending_realtime_start_ = false;
+    skip_realtime_wait_once_ = false;
+    realtime_start_deadline_us_ = 0;
+    capture_ready_generation_.store(UINT32_MAX);
+    audio_service_.WaitForCaptureReady(false);
+}
+
+void Application::ContinueRealtimeListeningStart() {
+    if (!pending_realtime_start_)
+        return;
+    auto* codec = Board::GetInstance().GetAudioCodec();
+    if (GetDeviceState() != kDeviceStateListening || aec_mode_ != kAecOnDeviceSide ||
+        !codec->SoftwareReference() || !protocol_ || !protocol_->IsAudioChannelOpened() ||
+        protocol_->AudioChannelEpoch() != realtime_start_channel_epoch_) {
+        CancelPendingRealtimeStart();
+        return;
+    }
+    if (codec->ReferenceFaulted()) {
+        SetAecMode(kAecOff);
+        return;
+    }
+    const bool expired = esp_timer_get_time() >= realtime_start_deadline_us_;
+    if (!expired && (capture_ready_generation_.load() != codec->CaptureGeneration() ||
+                     !codec->RealtimeEligible()))
+        return;
+    const auto mode = expired ? kListeningModeAutoStop : GetDefaultListeningMode();
+    ESP_LOGI(TAG, "realtime_start %s capture=%lu channel=%lu",
+             expired ? "timeout_auto" : (mode == kListeningModeRealtime ? "ready" : "readiness_lost_auto"),
+             static_cast<unsigned long>(codec->CaptureGeneration()),
+             static_cast<unsigned long>(realtime_start_channel_epoch_));
+    CancelPendingRealtimeStart();
+    listening_mode_ = mode;
+    // A timeout must not rearm even when the audio processor failed to start.
+    skip_realtime_wait_once_ = true;
+    StartListeningAudio();
+}
