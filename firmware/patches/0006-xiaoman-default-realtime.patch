+void AudioService::NotifyCaptureReady() {
+    if (!capture_ready_waiting_.load() || !callbacks_.on_capture_ready ||
+        !codec_->SoftwareReference())
+        return;
+    const auto generation = audio_engine_->OutputCaptureGeneration();
+    if (generation == codec_->CaptureGeneration() && codec_->RealtimeEligible())
+        callbacks_.on_capture_ready(generation);
+}
