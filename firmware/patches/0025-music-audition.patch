+bool BoxAudioCodec::ReopenDuplexForMusic(int rate) {
+    if(rate!=24000 && rate!=48000)return false;
+    std::lock_guard<std::mutex> lock(data_if_mutex_);
+    const int out_closed=esp_codec_dev_close(output_dev_);
+    const int in_closed=esp_codec_dev_close(input_dev_);
+    input_enabled_=output_enabled_=false;
+    if(out_closed!=ESP_CODEC_DEV_OK || in_closed!=ESP_CODEC_DEV_OK)return false;
+    // Public sample rates remain the voice configuration. Exclusive music
+    // owns its hardware rate in the adapter and verifies actual clock readback.
+    esp_codec_dev_sample_info_t input{};
+    input.bits_per_sample=16;input.channel=4;input.channel_mask=ESP_CODEC_DEV_MAKE_CHANNEL_MASK(0);
+    if(input_reference_)input.channel_mask|=ESP_CODEC_DEV_MAKE_CHANNEL_MASK(1);
+    input.sample_rate=rate;
+    if(esp_codec_dev_open(input_dev_,&input)!=ESP_CODEC_DEV_OK)return false;
+    input_enabled_=true;
+    if(esp_codec_dev_set_in_channel_gain(input_dev_,ESP_CODEC_DEV_MAKE_CHANNEL_MASK(0),input_gain_)!=ESP_CODEC_DEV_OK)return false;
+    if(input_reference_ && reference_gain_channel_>=0 && esp_codec_dev_set_in_channel_gain(input_dev_,
+        ESP_CODEC_DEV_MAKE_CHANNEL_MASK(reference_gain_channel_),reference_gain_)!=ESP_CODEC_DEV_OK)return false;
+    esp_codec_dev_sample_info_t output{};
+    output.bits_per_sample=16;output.channel=1;output.sample_rate=rate;
+    if(esp_codec_dev_open(output_dev_,&output)!=ESP_CODEC_DEV_OK)return false;
+    output_enabled_=true;
+    return esp_codec_dev_set_out_mute(output_dev_,true)==ESP_CODEC_DEV_OK &&
+           esp_codec_dev_set_out_vol(output_dev_,output_volume_)==ESP_CODEC_DEV_OK;
+}
+#endif
