+void AudioService::PrintC3Resources() const {
+#if CONFIG_XMINI_C3_VOICE_BARGE
+    constexpr uint32_t caps = MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT;
+    // ESP-IDF reports stack highwater in bytes. Never pass NULL: that would
+    // report this calling main task rather than an audio task not yet started.
+    unsigned input_stack = 0, opus_stack = 0;
+    // C3 is single-core. Stop sets service_stopped_ before either worker can
+    // exit; keep that lifetime check and TCB reads indivisible to task deletion.
+    // No heap query, logging or blocking API runs while scheduling is paused.
+    vTaskSuspendAll();
+    if (!service_stopped_.load()) {
+        if (audio_input_task_handle_)
+            input_stack = static_cast<unsigned>(uxTaskGetStackHighWaterMark(audio_input_task_handle_));
+        if (opus_codec_task_handle_)
+            opus_stack = static_cast<unsigned>(uxTaskGetStackHighWaterMark(opus_codec_task_handle_));
+    }
+    xTaskResumeAll();
+    ESP_LOGI(TAG, "C3 resources free=%u largest=%u min=%u input_stack_min=%u opus_stack_min=%u",
+        static_cast<unsigned>(heap_caps_get_free_size(caps)),
+        static_cast<unsigned>(heap_caps_get_largest_free_block(caps)),
+        static_cast<unsigned>(heap_caps_get_minimum_free_size(caps)), input_stack, opus_stack);
+#endif
+}
