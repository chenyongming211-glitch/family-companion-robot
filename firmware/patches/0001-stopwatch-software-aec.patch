+void AudioService::SetExperimentUplink(bool enabled, bool observer_tail) {
+    if (!codec_ || !codec_->SoftwareReference())
+        return;
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    experiment_authorization_.Request(enabled, codec_->ReferenceIntegrity());
+    observer_tail_.Begin(enabled && observer_tail);
+    UpdateExperimentGateLocked();
+}
+
+void AudioService::UpdateExperimentGate() {
+    if (!codec_->SoftwareReference())
+        return;
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    UpdateExperimentGateLocked();
+}
+
+void AudioService::UpdateExperimentGateLocked() {
+    // Queue/in-flight drain excludes an outstanding write, but submitted DMA
+    // may still sound. Keep local observation running through the nonblocking
+    // stock-equivalent 120ms guard, then flush raw backlog before a fresh epoch.
+    if (observer_tail_.Advance(esp_timer_get_time(), IsPlaybackDrainedLocked(), output_activity_))
+        codec_->CaptureBoundary();
+    const auto generation = codec_->CaptureGeneration();
+    const bool permitted =
+        !observer_tail_.pending() &&
+        experiment_authorization_.Allows(codec_->ReferenceFaulted(), codec_->ReferenceIntegrity());
+    if (experiment_gate_.Set(permitted, generation)) {
+        audio_encode_queue_.clear();
+        audio_send_queue_.clear();
+        audio_engine_->SetOutputEpoch(experiment_gate_.epoch());
+    }
+}
+
+bool AudioService::CaptureRequested() const {
+    const auto bits = xEventGroupGetBits(event_group_);
+    return !service_stopped_.load() &&
+           (bits & (AS_EVENT_WAKE_WORD_RUNNING | AS_EVENT_AUDIO_PROCESSOR_RUNNING |
+                    AS_EVENT_AUDIO_TESTING_RUNNING));
+}
+void AudioService::UpdateCaptureActive() {
+    capture_activation_.Refresh([this] { return CaptureRequested(); },
+                                [this](bool active) { codec_->SetCaptureActive(active); });
+}
+void AudioService::SetCaptureWarmup(bool hold) {
+    capture_activation_.Warmup(
+        hold, [this] { return CaptureRequested(); },
+        [this](bool active) { codec_->SetCaptureActive(active); });
+}
