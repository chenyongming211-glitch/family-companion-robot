# Firmware sources, patches and lock files belong in Git; local builds do not.
/firmware/.cache/
/firmware/build/
/firmware/managed_components/
/firmware/sdkconfig
/firmware/sdkconfig.old

# Runtime conversation snapshots and private device evidence never belong in Git.
/records/
/data/records/
/runtime/
/backups/
*.wav
*.pcm
*.opus
