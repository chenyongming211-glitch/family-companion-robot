<view class="family-page">
  <view class="family-heading">
    设备详情
  </view>
  <view class="family-error" wx:if="{{error}}">
    {{error}}
  </view>
  <view wx:if="{{loading}}">
    正在读取…
  </view>
  <view wx:if="{{device}}" class="family-card">
    <view class="family-title">
      {{device.name}}
    </view>
    <view>
      {{device.location || '未设置位置'}} · {{device.model}}
    </view>
    <view>
      {{runtime ? runtime.connectionLabel : '状态未确认'}}
    </view>
    <view class="family-muted">上报时间 {{runtime ? runtime.seenLabel : '未读取'}}</view>
    <view>音量：{{runtime && runtime.volume !== null ? runtime.volume : '未上报'}}</view>
    <view>亮度：{{runtime && runtime.brightness !== null ? runtime.brightness : '未上报'}}</view>
    <button bindtap="chats">
      聊天记录
    </button>
    <button bindtap="memories">
      近期记忆
    </button>
    <button bindtap="settings">
      设备设置
    </button>
  </view>
  <button bindtap="refresh" disabled="{{loading}}">
    重新读取
  </button>
  <button bindtap="home">
    返回家庭首页
  </button>
</view>
