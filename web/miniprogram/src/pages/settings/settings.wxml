<view class="family-page">
  <view class="family-heading">
    设备设置
  </view>
  <view class="family-error" wx:if="{{error}}">
    {{error}}
  </view>
  <view wx:if="{{loading}}">
    正在读取…
  </view>
  <view wx:if="{{settings}}" class="family-card">
    <view class="family-label">
      家庭展示昵称
    </view>
    <input value="{{name}}" data-field="name" bindinput="input" disabled="{{!settings.canEdit || saving}}" maxlength="12"/>
    <view class="family-label">
      摆放位置
    </view>
    <input value="{{location}}" data-field="location" bindinput="input" disabled="{{!settings.canEdit || saving}}" maxlength="24"/>
    <view wx:if="{{!settings.canEdit}}">
      当前成员只可查看，请联系家庭管理成员修改
    </view>
    <button wx:if="{{settings.canEdit}}" bindtap="save" disabled="{{saving || loading}}">
      {{saving ? '正在保存…' : '保存云端展示设置'}}
    </button>
  </view>
  <view class="family-card">
    <view>{{runtime ? runtime.connectionLabel : '状态未确认'}} · 上报时间 {{runtime ? runtime.seenLabel : '未读取'}}</view>
    <view class="family-muted">当前值来自设备上报；收到匹配回执才显示生效。</view>
    <view class="family-muted">每格 10，松手即设置；等待回执期间请稍候。</view>
    <view>音量实际值：{{runtime && runtime.volume !== null ? runtime.volume : '未上报'}} · 待设置 {{volumeDraft}}</view>
    <view class="runtime-slider">
      <slider min="0" max="100" step="10" value="{{volumeDraft}}" data-field="volume" bindchanging="runtimeInput" bindchange="runtimeCommit" disabled="{{loading || controlling || !runtime || !runtime.canControl || runtime.connection !== 'online' || runtime.volume === null}}"/>
      <view class="runtime-ticks">
        <view wx:for="{{runtimeTicks}}" wx:key="*this" class="runtime-tick" style="left:{{item}}%"></view>
        <text class="runtime-scale runtime-scale-start">0</text><text class="runtime-scale runtime-scale-mid">50</text><text class="runtime-scale runtime-scale-end">100</text>
      </view>
    </view>
    <view>亮度实际值：{{runtime && runtime.brightness !== null ? runtime.brightness : '未上报'}} · 待设置 {{brightnessDraft}}</view>
    <view class="runtime-slider">
      <slider min="0" max="100" step="10" value="{{brightnessDraft}}" data-field="brightness" bindchanging="runtimeInput" bindchange="runtimeCommit" disabled="{{loading || controlling || !runtime || !runtime.canControl || runtime.connection !== 'online' || runtime.brightness === null}}"/>
      <view class="runtime-ticks">
        <view wx:for="{{runtimeTicks}}" wx:key="*this" class="runtime-tick" style="left:{{item}}%"></view>
        <text class="runtime-scale runtime-scale-start">0</text><text class="runtime-scale runtime-scale-mid">50</text><text class="runtime-scale runtime-scale-end">100</text>
      </view>
    </view>
    <view>{{controlNotice}}</view>
  </view>
  <view>
    {{notice}}
  </view>
  <button bindtap="refresh" disabled="{{loading || saving}}">
    重新读取
  </button>
</view>
