<view class="family-page">
  <view class="family-heading">
    设备设置
  </view>
  <view class="family-error" wx:if="{{error}}">
    {{error}}
  </view>
  <view wx:if="{{loading}}">
    正在读取…
  </view>
  <view wx:if="{{settings}}" class="family-card">
    <view class="family-label">
      家庭展示昵称
    </view>
    <input value="{{name}}" data-field="name" bindinput="input" disabled="{{!settings.canEdit || saving}}" maxlength="12"/>
    <view class="family-label">
      摆放位置
    </view>
    <input value="{{location}}" data-field="location" bindinput="input" disabled="{{!settings.canEdit || saving}}" maxlength="24"/>
    <view wx:if="{{!settings.canEdit}}">
      当前成员只可查看，请联系家庭管理成员修改
    </view>
    <button wx:if="{{settings.canEdit}}" bindtap="save" disabled="{{saving || loading}}">
      {{saving ? '正在保存…' : '保存云端展示设置'}}
    </button>
  </view>
  <view class="family-card">
    <view>{{runtime ? runtime.connectionLabel : '状态未确认'}} · 上报时间 {{runtime ? runtime.seenLabel : '未读取'}}</view>
    <view class="family-muted">当前值来自设备上报；收到匹配回执才显示生效。</view>
    <view>音量实际值：{{runtime && runtime.volume !== null ? runtime.volume : '未上报'}} · 待设置 {{volumeDraft}}</view>
    <slider min="0" max="100" step="1" value="{{volumeDraft}}" data-field="volume" bindchange="runtimeInput" disabled="{{controlling || !runtime || !runtime.canControl || runtime.connection !== 'online' || runtime.volume === null}}"/>
    <button data-field="volume" bindtap="control" disabled="{{controlling || !runtime || !runtime.canControl || runtime.connection !== 'online' || runtime.volume === null}}">设置音量</button>
    <view>亮度实际值：{{runtime && runtime.brightness !== null ? runtime.brightness : '未上报'}} · 待设置 {{brightnessDraft}}</view>
    <slider min="0" max="100" step="1" value="{{brightnessDraft}}" data-field="brightness" bindchange="runtimeInput" disabled="{{controlling || !runtime || !runtime.canControl || runtime.connection !== 'online' || runtime.brightness === null}}"/>
    <button data-field="brightness" bindtap="control" disabled="{{controlling || !runtime || !runtime.canControl || runtime.connection !== 'online' || runtime.brightness === null}}">设置亮度</button>
    <view>{{controlNotice}}</view>
  </view>
  <view>
    {{notice}}
  </view>
  <button bindtap="refresh" disabled="{{loading || saving}}">
    重新读取
  </button>
</view>
