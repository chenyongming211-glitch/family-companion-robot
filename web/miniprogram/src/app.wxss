page{background:#f5f6f8;color:#172534;font-size:30rpx}view,input,button,picker{box-sizing:border-box}button{font-size:30rpx}button[type=primary]{background:#18664d}button[disabled]{opacity:.55}input{height:90rpx;border:1px solid #cfd7df;border-radius:12rpx;padding:0 22rpx;margin-top:16rpx;background:white}button{margin-top:20rpx}picker{margin-top:16rpx;padding:24rpx;border:1px solid #cfd7df;border-radius:12rpx}.page{padding:36rpx}.title{font-size:44rpx;font-weight:600;margin-bottom:20rpx}.card{background:white;padding:30rpx;border-radius:16rpx;margin:24rpx 0}.note{font-size:26rpx;color:#5b6774;line-height:1.7}.error{background:#fff1ed;color:#9b2d14;padding:24rpx;border-radius:12rpx;margin-top:20rpx}.status{font-weight:600;font-size:34rpx}.label{margin-top:22rpx;display:block}
